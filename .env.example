# ─── Postgres (usado por docker-compose para crear la BD) ──────────────────
POSTGRES_USER=corradi
POSTGRES_PASSWORD=corradi
POSTGRES_DB=corradi
# En local sin Docker apunta a tu Postgres; en compose lo inyecta el propio compose.
DATABASE_URL=postgresql://corradi:corradi@localhost:5432/corradi

# ─── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=                       # canal de difusión, formato -100xxxxxxxxxx
TELEGRAM_CHANNEL_USERNAME=                 # username público del canal, sin @ (para enlazar posts en el resumen)
ADMIN_TELEGRAM_IDS=                        # IDs admin separados por coma (de @userinfobot)
WHATSAPP_HANDOFF_TELEGRAM_GROUP_ID=        # grupo privado para el handoff por Telegram (si HANDOFF_MODE=telegram)

# ─── Handoff a WhatsApp ─────────────────────────────────────────────────────
HANDOFF_MODE=none                           # telegram | whatsapp_twilio | whatsapp_cloud | none (aparcado en el lanzamiento)
WHATSAPP_RECIPIENTS=                        # números admin (sin +), separados por coma

# Twilio (BSP) — ver docs/archive/whatsapp_twilio_setup.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=                        # whatsapp:+14155238886 (sandbox) o tu número
TWILIO_CONTENT_SID=                          # HX... de la Content Template (vacío = texto libre, ventana 24h)
WHATSAPP_ALLOWED_SENDERS=                     # entrante: números (sin +) autorizados a enviar oportunidades
TWILIO_VALIDATE_SIGNATURE=false              # ponlo a true en producción (valida X-Twilio-Signature)

# Meta Cloud API directo (alternativa) — ver docs/archive/whatsapp_cloud_setup.md
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=nueva_oportunidad
WHATSAPP_TEMPLATE_LANG=es
GRAPH_API_VERSION=v21.0

# ─── LLM (Gemini) ──────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                        # 'gemini' (real) o 'fake' (dry-run sin claves)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ─── Lógica de negocio ─────────────────────────────────────────────────────
# Fecha límite estimada cuando el mensaje no trae ninguna (y +2 si es "última hora")
DEFAULT_DEADLINE_DAYS=5
LAST_MINUTE_DEADLINE_DAYS=2
# Solo se aceptan oportunidades cuya deadline caiga dentro de estos meses (red de seguridad)
MAX_DEADLINE_MONTHS=3
DEDUP_THRESHOLD=0.88
TIMEZONE=Europe/Madrid
SUMMARY_HOUR=20
IDENTIFIER_PREFIX=CORRADI

# ─── Mapa público ──────────────────────────────────────────────────────────
# Dominio del mapa (Caddy pide el certificado HTTPS para este nombre). Necesita un
# registro DNS tipo A apuntando a la IP pública del servidor. Vacío = HTTP sin TLS.
MAP_DOMAIN=
# URL que se enlaza desde el resumen diario (vacío = no se enlaza).
MAP_PUBLIC_URL=

# ─── Chatbot del mapa (ver docs/chatbot_mapa.md) ────────────────────────────
# Reutiliza GEMINI_API_KEY y LLM_MODEL de arriba, no una clave/modelo aparte.
# Tope de gasto REAL (medido, no estimado) en el mes en curso. Al alcanzarlo, el endpoint
# deja de llamar a Gemini y responde con un aviso, hasta que empiece el mes siguiente.
CHAT_MONTHLY_BUDGET_USD=5.0
# Rate-limit por IP (ventana deslizante en memoria del proceso `api`).
CHAT_RATE_LIMIT_PER_HOUR=10
CHAT_RATE_LIMIT_PER_DAY=30
# Cuánto se cachea en memoria el catálogo compacto de oportunidades abiertas.
CHAT_CATALOG_CACHE_SECONDS=180

# ─── Instagram (Graph API) ──────────────────────────────────────────────────
# Ver docs/instagram_automation.md para la puesta en marcha completa (crear la cuenta,
# convertirla a Business, vincular la Página de Facebook, sacar el token...).
# Vacío = publicación en Instagram desactivada, el resto del pipeline sigue igual.
INSTAGRAM_LONG_LIVED_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Base pública desde la que Instagram descarga las imágenes — nuestra propia API, la misma
# que sirve el mapa (p.ej. https://mapa.proactivefuture.eu). NO un repo aparte.
INSTAGRAM_IMAGE_BASE_URL=
# Intentos antes de rendirse con una oportunidad y avisar a los admins (sin tope diario de
# publicaciones — a petición del usuario, esto es solo un límite de reintentos por ficha).
INSTAGRAM_MAX_ATTEMPTS=5
# Carpeta compartida entre `bot` (genera el .mp4 del Reel) y `api` (lo sirve) — volumen
# `media_data` en docker-compose.yml, normalmente no hace falta tocar este valor.
MEDIA_DIR=/data/media
