# Proxy inverso con HTTPS automático (Let's Encrypt) para el mapa público.
#
# MAP_DOMAIN se define en .env (p.ej. mapa.proactivefuture.eu). Caddy pide y renueva el
# certificado solo, siempre que el dominio apunte por DNS a esta máquina y los puertos
# 80 y 443 estén abiertos.
#
# Si MAP_DOMAIN está vacío, escucha en :80 sin TLS (útil en local / antes de tener DNS).

{$MAP_DOMAIN::80} {
	encode zstd gzip

	# Superficie pública mínima: solo el mapa y sus datos de lectura.
	# Todo lo demás (webhooks, docs de la API) se corta aquí como segunda barrera,
	# además de no estar montado en la app.
	@publico path / /mapa /corradi-erasmus /proyecto/* /og.png /assets/* /api/map /api/visit /api/click /api/chat /api/chat/status /api/stats /health /opportunities /opportunities/* /ig/* /fonts/* /robots.txt /sitemap.xml /estadisticas
	handle @publico {
		reverse_proxy api:8000
	}

	# Panel para publicar desde la web (/publicar). Va aparte del bloque de arriba solo por
	# claridad: esto es la única superficie de ESCRITURA pública. Todas estas rutas exigen
	# sesión válida en la app (cookie firmada, ver app/api/auth.py) menos /api/auth/*, que
	# es justo por donde se consigue esa sesión.
	@panel path /publicar /api/auth/me /api/auth/telegram /api/auth/logout /api/submit/preview /api/submit/commit /api/mine /api/mine/edit /api/mine/delete
	handle @panel {
		reverse_proxy api:8000
	}

	# Enlace corto para compartir (p.ej. WhatsApp): /2026-0040 redirige a la ficha en el
	# mapa. Patrón exacto AAAA-NNNN, nada más pasa por aquí.
	@enlace_corto path_regexp ^/\d{4}-\d{4}$
	handle @enlace_corto {
		reverse_proxy api:8000
	}

	handle {
		respond "No encontrado" 404
	}

	header {
		# Endurecimiento básico: la página no debe poder embeberse ni filtrar referrer.
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 3
		}
	}
}
